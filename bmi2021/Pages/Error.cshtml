@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="content-page">
    <p class="eyebrow">Error</p>
    <h1>Sorry, something went wrong.</h1>
    <p>Please return to the calculator and try again.</p>
    <a class="text-link" asp-page="/bmi">Back to the calculator</a>

    @if (Model.ShowRequestId)
    {
        <p class="request-id">Reference: <code>@Model.RequestId</code></p>
    }
</section>
